{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbuddy.local/schemas/agent-protocol/result_envelope.schema.json",
  "title": "Agent Result Envelope",
  "description": "上行信封契约：成员产出回传主理人时必须附加的JSON信封（基于主理人MD 265-297行定义，2026-09-03形式化）。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "agent_id",
    "task_id",
    "phase",
    "status",
    "confidence",
    "deliverable_summary"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$",
      "minLength": 3,
      "maxLength": 64,
      "description": "成员ID（kebab-case，对应MD文件名）"
    },
    "task_id": {
      "type": "string",
      "pattern": "^T-[0-9]{8}-[A-Za-z0-9]{1,8}$",
      "description": "任务ID（YYYYMMDD-{NNN|字母数字后缀}，例T-20260903-001或T-20260903-B01）"
    },
    "phase": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "阶段编号0-5"
    },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed", "blocked"],
      "description": "状态自评（success=完整满足 / partial=部分满足issues非空 / failed=无法满足需重试 / blocked=前置条件不足）"
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "置信度自评0-100"
    },
    "deliverable_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "一句话摘要"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "ref"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["skill_ref", "prior_artifact", "source"]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "used_for": {
            "type": "string"
          }
        }
      },
      "description": "产出依据证据链（推荐但非必须）"
    },
    "issues": {
      "type": "array",
      "items": {"type": "string"},
      "description": "自评发现的问题列表"
    },
    "next_agent_hint": {
      "type": "string",
      "maxLength": 200,
      "description": "建议下游agent"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "成员自报：自身执行耗时（收到任务→产出完成），不含调度排队与回传链路。仅作参考，主理人不得用墙钟覆盖本字段。"
        },
        "duration_ms_wall": {
          "type": "integer",
          "minimum": 0,
          "description": "主理人回填：spawn→回传实测墙钟。端到端延迟与预算消耗一律以本字段为准。"
        },
        "duration_source": {
          "type": "string",
          "enum": ["self_report", "lead_measured", "estimated"],
          "description": "duration_ms 的口径来源。主理人回填 duration_ms_wall 时应同时置为 lead_measured。"
        },
        "retry_count": {"type": "integer", "minimum": 0}
      },
      "description": "执行指标（推荐但非必须）。duration_ms 与 duration_ms_wall 为两个独立口径，禁止互相覆盖（2026-10-14 双轨制）。"
    },
    "verdicts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": {
          "type": "string",
          "description": "裁决/表态结果：examiner 用 green|yellow|red；second_opinion 用 agree|conditional|disagree"
        },
        "score": {
          "type": "number",
          "description": "量化评分（如 examiner 黄区上界 4/5；reviewer 五维加权分）。供 L3 仲裁计分差≥2 自动触发（P2-12）机械比对，替代从正文抽取"
        }
      },
      "description": "结构化裁决（v1.2.0 新增·可选）：Reviewer 类成员填写，供主理人 L3 仲裁与 state_store 直接机械消费（J1）。非裁决类成员可省略。"
    }
  },
  "version": "1.2.0",
  "deprecated_fields": []
}