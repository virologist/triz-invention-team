{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbuddy.local/schemas/agent-protocol/task_payload.schema.json",
  "title": "Agent Task Payload",
  "description": "下行任务契约：主理人spawn成员时必须下发的task_payload（基于主理人MD 265-280行定义，2026-09-03形式化）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "phase",
    "instruction"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T-[0-9]{8}-[A-Za-z0-9]{1,8}$",
      "description": "任务ID（YYYYMMDD-{NNN|字母数字后缀}，例T-20260903-001或T-20261015-A01）。CYCLE-1 · S-E49：此前本字段写 `^T-[0-9]{8}-[0-9]{3,}$`（只允许纯数字），与 result_envelope.schema.json 的 pattern 冲突，且与实测基线（7 份成员信封 + 9 份 spawn 文档全部采用字母后缀 T-20261015-A01…A07）脱节 → 下游按本 schema 校验任务包必被拒。现与信封 schema 字面统一（两个方向的契约必须同形），由 preflight 第 15 项机械校验防漂移。"
    },
    "phase": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "阶段编号0-5"
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "任务指令（具体可执行）"
    },
    "input": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
          "dependency_artifacts": {
            "type": "array",
            "items": {"type": "string"},
            "description": "依赖的前序phase产出标识"
          },
          "domain_context": {
            "type": "string",
            "description": "领域上下文（坍缩结果）"
          }
        },
      "description": "任务输入上下文（推荐）"
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "min_directions": {
          "type": "integer",
          "minimum": 0,
          "description": "方向数下限（如≥3）"
        },
        "format": {
          "type": "string",
          "enum": ["markdown", "json", "text", "html"]
        }
      },
      "description": "输出契约约束（推荐）"
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string"},
      "description": "硬约束清单（推荐）"
    },
    "forbidden_boundary": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "description": "CYCLE-1 · S-E11：下行任务的禁止边界清单（来自 docs/architecture.md §二 角色矩阵「禁止边界」列，按成员角色取值）。使禁止边界从架构文档下沉到运行时任务契约——此前禁止边界只存在于文档，成员运行时上下文不含它，越权产出无机械拦截（原则①违背实例）。非 required：避免破坏历史信封；一致性由 scripts/contract_enforce.py --self-test 校验（真源=architecture.md 角色矩阵）"
    },
    "state_snapshot": {
      "type": "object",
      "additionalProperties": true,
      "description": "状态快照（推荐）"
    }
  },
  "version": "1.0.0",
  "deprecated_fields": []
}